// Copy this file to Secrets.xcconfig (same folder) and fill in real values.
// Secrets.xcconfig is gitignored — never commit real keys.
//
// NOTE: xcconfig cannot contain "//" inside values, so the Supabase URL is
// split — enter it WITHOUT the scheme; the app adds https:// automatically
// when the value doesn't start with http.

SUPABASE_URL = https:/$()/YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY = eyJ...your-anon-key
REVENUECAT_IOS_API_KEY = appl_xxxxxxxxxxxx
ONESIGNAL_APP_ID =
