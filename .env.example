# ===========================================================================
# Abbey's Bite — configuration NAMES (template only; no real values here)
#
# Copy to `.local-secrets.env` (gitignored) and fill in real values.
# Gradle reads `.local-secrets.env`, then `local.properties`, then the
# process environment (first hit wins per key).
#
# Server-only values (SUPABASE_ACCESS_TOKEN, *_API_KEY server keys,
# REVENUECAT_WEBHOOK_AUTH_SECRET, ONESIGNAL_APP_API_KEY, HUGGINGFACE_TOKEN)
# must NEVER be baked into the mobile binary — they are used by tooling and
# Supabase Edge Function secrets only.
# ===========================================================================

# Supabase (client)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxx

# Supabase (tooling only)
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=

# Local Gemma
# (GEMMA_MODEL_ID removed — not read by the build or app; only GEMMA_MODEL_FILE is)
GEMMA_MODEL_FILE=gemma-3n-E2B-it-int4.litertlm
AI_BACKEND=local
CLOUD_AI_FALLBACK_ENABLED=false
HUGGINGFACE_TOKEN=
MODEL_DOWNLOAD_URL=

# RevenueCat
REVENUECAT_ANDROID_PUBLIC_SDK_KEY=goog_xxxxxxxxxxxx
REVENUECAT_GALAXY_PUBLIC_SDK_KEY=galx_xxxxxxxxxxxx
REVENUECAT_IOS_PUBLIC_SDK_KEY=appl_xxxxxxxxxxxx
REVENUECAT_TEST_STORE_API_KEY=test_xxxxxxxxxxxx
REVENUECAT_ENTITLEMENT_ID=abbeysbite_premium
REVENUECAT_OFFERING_ID=default
REVENUECAT_WEBHOOK_AUTH_SECRET=

# OneSignal
ONESIGNAL_APP_ID=
ONESIGNAL_APP_API_KEY=

# AdMob (Community-native ads only — no interstitial/rewarded units)
ADMOB_ANDROID_APP_ID=PENDING
ADMOB_NATIVE_COMMUNITY_AD_UNIT_ID=PENDING

# Legal
PRIVACY_POLICY_URL=PENDING
TERMS_URL=PENDING
COMMUNITY_GUIDELINES_URL=PENDING
SUPPORT_URL=PENDING
